# RDFS/OWL class integrity — migrated from the hand-written RDS001 check.
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix slint: <https://semanticlint.org/ns#> .

slint:RDS001 a sh:NodeShape ;
    slint:checkId "RDS001" ;
    slint:appliesTo "RDFS", "OWL" ;
    sh:targetClass owl:Class, rdfs:Class ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Class has no rdfs:label" ;
    ] .
